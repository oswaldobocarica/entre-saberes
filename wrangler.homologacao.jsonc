{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entre-saberes-homologacao",
  "main": "neon/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
