{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calm-voice-5d27",
  "main": "_worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
