{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calm-voice-5d27",
  "main": "_worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "containers": [
    {
      "class_name": "DoclingContainer",
      "image": "./Dockerfile.docling",
      "max_instances": 1,
      "instance_type": "standard-2",
      "constraints": {
        "regions": ["SAM"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCLING",
        "class_name": "DoclingContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-docling",
      "new_sqlite_classes": ["DoclingContainer"]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
